# Utilisé par la CLI Prisma lancée depuis l'hôte (npx prisma migrate/generate).
# Copie ce fichier en ".env". Les valeurs doivent correspondre au .env racine.
DATABASE_URL="postgresql://fayli:changeme@localhost:5432/fayli?schema=public"

# Cloudinary (stockage des images de la galerie)
# Récupère cette URL dans ton dashboard Cloudinary.
# Format : cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
